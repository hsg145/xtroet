# ─────────────────────────────────────────────────────────────────────────────
#  RanksBot configuration
#
#  QUICK START (no tunnel, no public URL, works offline-ish):
#      cp .env.example .env      # fill in the values below
#      npm run doctor            # finds whatever is broken
#      npm start
#
#  Never commit .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kick app (kicks.com/developer → Edit your application) ──────────────────
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Must match the "Redirect URIs" field in the Kick dashboard exactly.
# Production (ربط القناة من الموقع): https://ixtroet.vercel.app/api/kick-callback
# Local (npm run auth):  http://localhost:3000/callback
# أضف الرابطين معاً بزر + في لوحة Kick.
KICK_REDIRECT_URI=https://ixtroet.vercel.app/api/kick-callback
KICK_TARGET_CHANNEL_SLUG=xtroet

# How chat is received:
#   pusher  = WebSocket only. DEFAULT. Needs no tunnel and no public URL.
#   webhook = official webhooks only. Needs PUBLIC_BASE_URL.
#   both    = run both; a shared dedupe prevents double counting.
INGEST_MODE=pusher

# Pusher needs the CHATROOM id, which is NOT the broadcaster user id.
# Leave empty and the bot tries kick.com/api/v2/channels/<slug>, but Kick's WAF
# usually answers HTTP 403 to a server. To get it manually:
#   open  https://kick.com/api/v2/channels/<slug>  in your browser
#   find  "chatroom":{"id":NUMBER
KICK_CHATROOM_ID=

# Pusher reliability tuning.
PUSHER_WATCHDOG_SECONDS=120
PUSHER_BACKOFF_MAX_MS=30000

# Leave empty unless INGEST_MODE is webhook/both. Quick-tunnel URLs change on
# every run and Kick only posts to the URL saved in its dashboard.
PUBLIC_BASE_URL=

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Server-side key only (sb_secret_... or the legacy service_role JWT).
# The publishable/anon key will NOT work and must not be used here.
SUPABASE_SECRET_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Behaviour ───────────────────────────────────────────────────────────────
COMMAND_PREFIX=!
POINTS_COOLDOWN_SECONDS=10
FLUSH_INTERVAL_MS=1000
ANNOUNCE_RANKUPS=true
IGNORED_USERNAMES=botrix,kickbot,nightbot
# Your numeric Kick user id, for !addpts / !setpts / !تصفير
ADMIN_USER_IDS=
# Access is granted to the channel owner automatically, so this is optional.
TEST_MODE=false
MIN_MESSAGE_LENGTH=2