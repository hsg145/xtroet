# ============================================================
#  XTROET Bot — RanksBot (Kick chat points + ranks)
#
#  ⚠️  كل متغير هنا لازم ينتهي بـ  _BOT
#  سبب: الموقع (الجذر) وبنفسه يستعمل أسماء متطابقة مثل
#  SUPABASE_URL و KICK_CLIENT_ID — وبقيم مختلفة تماماً.
#  اللاحقة _BOT تمنع أي خلط بينهما على Railway/Vercel/local.
# ============================================================

# ── Kick app (kicks.com/developer → My Apps) ────────────────────
KICK_CLIENT_ID_BOT=
KICK_CLIENT_SECRET_BOT=
# Must match "Redirect URIs" in the Kick dashboard exactly.
# Production (ربط القناة من الموقع): https://ixtroet.vercel.app/api/kick-callback
# Local (npm run auth): http://localhost:3000/callback
KICK_REDIRECT_URI_BOT=https://ixtroet.vercel.app/api/kick-callback
KICK_TARGET_CHANNEL_SLUG_BOT=xtroet
KICK_SENDER_TYPE_BOT=bot

# chat ingestion
#   pusher  = WebSocket only (default, no tunnel needed)
#   webhook = official webhooks (needs PUBLIC_BASE_URL_BOT)
#   both    = both, with a dedupe
INGEST_MODE_BOT=pusher

# Pusher needs the chatroom id — NOT the broadcaster user id.
# Kick's WAF usually 403s a server, so get it manually:
#   open https://kick.com/api/v2/channels/<slug> in your browser
#   find  "chatroom":{"id":NUMBER
KICK_CHATROOM_ID_BOT=

# Pusher tuning
PUSHER_WATCHDOG_SECONDS_BOT=120
PUSHER_BACKOFF_MAX_MS_BOT=30000

# Only needed when INGEST_MODE includes webhook.
PUBLIC_BASE_URL_BOT=

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL_BOT=https://xxxxxxxxxxxx.supabase.co
# Server-side key only (sb_secret_... or legacy service_role JWT).
SUPABASE_SECRET_KEY_BOT=

# ── Server ──────────────────────────────────────────────────────
PORT_BOT=3000
NODE_ENV_BOT=production
LOG_LEVEL_BOT=info

# ── Behaviour ───────────────────────────────────────────────────
COMMAND_PREFIX_BOT=!
POINTS_COOLDOWN_SECONDS_BOT=10
FLUSH_INTERVAL_MS_BOT=1000
ANNOUNCE_RANKUPS_BOT=true
IGNORED_USERNAMES_BOT=botrix,kickbot,nightbot
# Numeric Kick user ids for !addpts / !setpts / !تصفير
ADMIN_USER_IDS_BOT=
TEST_MODE_BOT=false
MIN_MESSAGE_LENGTH_BOT=2