{
  "name": "ranksbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "auth": "tsx scripts/auth.ts",
    "launch": "tsx scripts/launch.ts",
    "doctor": "tsx scripts/doctor.ts",
    "simulate": "tsx scripts/simulate.ts",
    "subscribe": "tsx scripts/subscribe.ts",
    "resubscribe": "tsx scripts/resubscribe.ts",
    "set-rank-markers": "tsx scripts/set-rank-markers.ts",
    "reset-channel": "tsx scripts/reset-channel.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
