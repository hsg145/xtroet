# ============================================================
#  XTROET AI — GROQ Keys
#  انسخ هذا الملف إلى اسم:  .env   (نفس المجلد)
#  ثم الصق مفاتيحك مكان CHANGE_ME
# ============================================================

# المفتاح الأول (الأساسي)
GROQ_API_KEY_1=CHANGE_ME_1

# المفتاح الثاني (احتياطي — يعمل تلقائياً إذا فشل الأول)
GROQ_API_KEY_2=CHANGE_ME_2

# المفتاح الثالث (احتياطي أخير)
GROQ_API_KEY_3=CHANGE_ME_3

# --- للتشغيل المحلي (npm run dev) فقط ---
# الفرونت يحتاج نسخة VITE_ عشان يجرب GROQ مباشرة إذا الباك-إند المحلي مو شغال.
# (في Vercel الحقيقي: المفاتيح تبقى بالسيرفر فقط وما تنكشف)
VITE_GROQ_API_KEYS=CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3

# ============================================================
#  XTROET Bot — Kick OAuth (ربط القناة من الموقع)
#  لتبديل البوت لاحقاً: غيّر القيمتين فقط في Vercel + هنا،
#  ونفس زر الموقع (/api/kick-login) يربط البوت الجديد فوراً.
# ============================================================

# من لوحة Kick للمطورين (صورة إنشاء التطبيق)
KICK_CLIENT_ID=CHANGE_ME
KICK_CLIENT_SECRET=CHANGE_ME
# يجب أن يطابق خانة Redirect URIs في Kick حرفياً:
# الإنتاج: https://ixtroet.vercel.app/api/kick-callback
KICK_REDIRECT_URI=https://ixtroet.vercel.app/api/kick-callback
KICK_TARGET_CHANNEL_SLUG=xtroet
# الصلاحيات المطلوبة (user:read channel:read chat:write events:subscribe)
KICK_SCOPES=user:read channel:read chat:write events:subscribe

# نفس مشروع Supabase الذي يستخدمه BOT/ (جدولا channels + kick_tokens)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=CHANGE_ME_SERVICE_KEY
